{
  "name": "@mambalabsdev/mcp-news-site-article-archive",
  "version": "1.0.0",
  "description": "MCP server for News Site Article Archive. Full article text and dates from named news sites across a past date range. No code, no AI. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-news-site-article-archive": "./build/index.js"
  },
  "files": [
    "build",
