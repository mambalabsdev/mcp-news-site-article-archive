    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "news-scraper",
    "article-archive",
    "article-text",
    "news-archive",
    "internet-archive",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/news-site-article-archive",
  "repository": {
    "type": "git",
